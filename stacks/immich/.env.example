# Copy to .env next to docker-compose.yml (gitignored).
# Set these paths and the IP; keep the rest.
# Library on the HDD: a directory on the HDD's mount point (check with
# `findmnt -T <path>` and `lsblk -o NAME,ROTA,MOUNTPOINT`; ROTA=1 is a hard disk).
UPLOAD_LOCATION=/mnt/hdd/immich/library

# blackberry's static LAN IP; the published port binds here.
IMMICH_BIND_IP=192.168.0.196

IMMICH_VERSION=v3
# Password of the `immich` role in the shared Postgres (stacks/db).
# A-Za-z0-9 only.
DB_PASSWORD=change-me
