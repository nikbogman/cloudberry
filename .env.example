# Copy this to .env at the repo root (gitignored, never committed). Loaded
# by Taskfile.yml into the task process only -- never your interactive shell.

# Only needed for a device's first `task tailscale` join.
TAILSCALE_AUTH_KEY="tskey-auth-xxxxx"

# ssh targets. On a fresh device that hasn't joined the tailnet yet, use a
# LAN address (e.g. 192.168.0.50). A ~/.ssh/config alias works too.
RASPBERRY_HOST="raspberry"
BLACKBERRY_HOST="blackberry"

# Required by `task waker`/`task hostd`
BLACKBERRY_MAC_ADDRESS="aa:bb:cc:dd:ee:ff"                # task waker
GRAFANA_CLOUD_LOKI_URL="https://logs-prod-xxx.grafana.net/loki/api/v1/push"
GRAFANA_CLOUD_LOKI_USER="123456"
GRAFANA_CLOUD_LOKI_API_KEY="glc_xxxxx"

# Optional
# RASPBERRY_SSH_USER="pi"
# BLACKBERRY_SSH_USER="admin"
# Fed to `sudo -S` -- only needed where sudo asks for a password (e.g.
# sudo-rs on blackberry).
# BLACKBERRY_SUDO_PASSWORD="hunter2"
# RASPBERRY_SUDO_PASSWORD=""
# Listen ports, default 5000
# WAKER_PORT="5000"
# HOSTD_PORT="5000"
