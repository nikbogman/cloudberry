# Sourced secrets/config file -- homelab-wide device and provisioning
# values. Each service under a top-level folder keeps its own .env
# alongside its code (e.g. platform/.env).
#
# Copy this to .env at the repo root (gitignored, never committed) and fill
# in real values. Loaders wrap the source in `set -a`, so plain
# KEY="value" is exported -- no `export` prefix needed:
#   deploy/deploy.sh  -- run deploys through it (e.g. `./deploy.sh --limit
#                        waker`) rather than `uv run pyinfra` directly; it
#                        sources this file *and* each service's .env
# It loads this file into its own process only, so these vars never leak
# into your interactive shell or linger after the command exits. Plain
# dev-machine env vars -- no encryption, no new persistence mechanism.
#
# Required (no default in settings.py -- a Deploy file that needs one of
# these raises a pydantic.ValidationError if it's unset):

TAILSCALE_AUTH_KEY="tskey-auth-xxxxx"                  # deploy_tailscale.py

# Have defaults in settings.py, but load-bearing in practice: pyinfra SSHes
# to exactly these hosts to run every Deploy file, including
# deploy_tailscale.py itself -- so on a fresh device that isn't joined yet,
# use a plain LAN address here (e.g. 192.168.0.50), not a tailnet name.
# Safe to leave as the LAN address permanently as long as the
# waker/sleeper devices stay on the same local network as the dev
# machine.
WAKER_HOST="pi-zero.tailnet"
SLEEPER_HOST="main-server.tailnet"

# Each device's real Tailscale MagicDNS name once joined
# (<device>.<tailnet-name>.ts.net -- check `tailscale status` or the admin
# console for your tailnet's actual name). Deliberately separate from
# WAKER_HOST/SLEEPER_HOST above: platform/sleeper_api.py derives UI_ORIGIN
# (https://{waker_tailnet_host}) and platform/waker.py derives the
# browser's SLEEPER_API_URL (https://{sleeper_tailnet_host}, served at
# /config.js) from these two specifically, since that's the only name
# `tailscale serve` issues a valid HTTPS cert for -- a LAN IP origin would
# fail CORS/HTTPS.
WAKER_TAILNET_HOST="pi-zero.your-tailnet-name.ts.net"
SLEEPER_TAILNET_HOST="main-server.your-tailnet-name.ts.net"

# Optional -- only set if you need to override the default in settings.py
# WAKER_SSH_USER="pi"
# SLEEPER_SSH_USER="admin"
# Only needed if sleeper's `sudo` is aliased to sudo-rs (Ubuntu 26.04
# default): sudo-rs prints "sudo: interactive authentication is required"
# instead of "sudo-rs: ...", which pyinfra's --use-sudo-password doesn't
# recognize, so it fails instead of prompting. Setting this bypasses that
# detection by supplying the password up front via pyinfra's sudo askpass.
# SLEEPER_SUDO_PASSWORD="hunter2"
