{"nodes": [{"id": "docs_adr_0008_doc", "label": "ADR-0008 (templated Caddyfile.j2 supersedes hand-edited Caddyfile)", "file_type": "document", "source_file": "services/pi-proxy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_adr_0011_doc", "label": "ADR-0011 (/server* route via server-side workload proxy)", "file_type": "document", "source_file": "services/pi-proxy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "services_pi_proxy_readme_doc", "label": "Pi proxy README", "file_type": "document", "source_file": "services/pi-proxy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "services_pi_proxy_readme_caddyfile", "label": "Caddyfile (design reference, superseded)", "file_type": "code", "source_file": "services/pi-proxy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "services_pi_proxy_readme_caddy_wol_plugin", "label": "caddy-wol plugin (dulli/caddy-wol, historical)", "file_type": "concept", "source_file": "services/pi-proxy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen because its documented pattern (reverse_proxy fails, handle_errors catches the 502, wake_on_lan sends the packet, a second reverse_proxy retries with a longer lb_try_duration) held and retried the original client request transparently."}, {"id": "services_pi_proxy_readme_caddy_jellywol_plugin", "label": "caddy-jellywol plugin (rejected alternative)", "file_type": "concept", "source_file": "services/pi-proxy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returns 503 + Retry-After and depends on the client re-requesting -- reasonable for Retry-After-aware media players but not a general transparent-success guarantee for arbitrary HTTP clients; also narrowly built around a specific ping_ip/ping_port health check."}, {"id": "services_pi_proxy_readme_caddy_tailscale_plugin", "label": "caddy-tailscale plugin (researched, unused)", "file_type": "concept", "source_file": "services/pi-proxy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provides bind tailscale/<node> (embedded tsnet) and tailscale_auth. Not used because this repo's established convention is binding to loopback and letting an external tailscale serve expose it -- mixing in a second tailnet-joining mechanism would pre-empt that future config rather than match it."}, {"id": "services_pi_proxy_readme_verification", "label": "Verification performed (caddy validate/run, historical)", "file_type": "rationale", "source_file": "services/pi-proxy/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two custom Caddy binaries built and tested with caddy validate, caddy fmt --diff, and live caddy run smoke tests confirming wake-on-error, already-awake fast path, no false-positive on genuine live 502s, and structural independence from Control UI/Pi API."}], "edges": [{"source": "services_pi_proxy_readme_caddyfile", "target": "pyinfra_readme_caddyfile_j2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "services/pi-proxy/README.md", "source_location": null, "weight": 1.0}, {"source": "services_pi_proxy_readme_caddyfile", "target": "pyinfra_readme_deploy_caddy_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "services/pi-proxy/README.md", "source_location": null, "weight": 1.0}, {"source": "services_pi_proxy_readme_caddyfile", "target": "docs_adr_0008_doc", "relation": "references", "confidence": "EXTR