{"nodes": [{"id": "claude_skills_graphify_skill_graphify_command", "label": "/graphify Skill Pipeline", "file_type": "document", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_skill_honesty_rules", "label": "Honesty Rules", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never invent an edge (use AMBIGUOUS if unsure), never skip the corpus size warning, always show token cost, never hide cohesion scores, never run HTML viz on >5000 nodes without warning."}, {"id": "claude_skills_graphify_skill_part_a_ast", "label": "Part A: Structural (AST) Extraction", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AST extraction is deterministic and free (no LLM, no API key). A code-only corpus skips semantic extraction entirely and needs nothing beyond this pass."}, {"id": "claude_skills_graphify_skill_part_b_semantic", "label": "Part B: Semantic Extraction", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses Gemini only if GEMINI_API_KEY/GOOGLE_API_KEY is already set; otherwise the host agent itself is the LLM (dispatches subagents). graphify never reads ANTHROPIC_API_KEY/OPENAI_API_KEY and must never block or prompt for a missing key."}], "edges": [{"source": "claude_skills_graphify_skill_graphify_command", "target": "claude_skills_graphify_references_github_and_merge_doc", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_