# PROTOTYPE -- validating the ergonomics of a sourced secrets file (ADR-0010).
#
# Copy this to secrets.sh (gitignored, never committed) and fill in real
# values. Run deploys via ./deploy.sh (e.g. `./deploy.sh inventory.py
# deploy.py --limit pi`) instead of `uv run pyinfra` directly -- deploy.sh
# loads this file into its own subprocess only, so these vars never leak
# into your interactive shell or linger after the command exits. This is
# still plain dev-machine env vars per ADR-0010 -- no encryption, no new
# persistence mechanism.
#
# Required (no default in settings.py -- a Deploy file that needs one of
# these raises a pydantic.ValidationError if it's unset):

export TAILSCALE_AUTH_KEY="tskey-auth-xxxxx"                  # deploy_tailscale.py
export SERVER_MAC_ADDRESS="aa:bb:cc:dd:ee:ff"                 # deploy_pi_api.py
export SERVER_API_ORIGIN="https://server-api.tailnet"          # deploy_pi_api.py
export UI_ORIGIN="https://ui.tailnet"                          # deploy_server_api.py
export GRAFANA_CLOUD_LOKI_URL="https://logs-prod-xxx.grafana.net/loki/api/v1/push"
export GRAFANA_CLOUD_LOKI_USER="123456"
export GRAFANA_CLOUD_LOKI_API_KEY="glc_xxxxx"
export SERVER_PROXY_PORT="8081"                                # deploy_caddy.py, ADR-0011

# Optional -- only export if you need to override the default in settings.py
# export PI_HOST="pi-zero.tailnet"
# export SERVER_HOST="main-server.tailnet"
# export HOMELAB_REPO_URL="git@github.com:nikbogman/homelab.git"
# export DEPLOY_REF="main"
