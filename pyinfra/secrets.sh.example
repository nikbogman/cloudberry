# Sourced secrets file (ADR-0010).
#
# Copy this to secrets.sh (gitignored, never committed) and fill in real
# values. Run deploys via ./deploy.sh (e.g. `./deploy.sh --limit gateway`)
# instead of `uv run pyinfra` directly -- deploy.sh loads this file into
# its own subprocess only, so these vars never leak into your interactive
# shell or linger after the command exits. This is still plain dev-machine
# env vars per ADR-0010 -- no encryption, no new persistence mechanism.
#
# Required (no default in settings.py -- a Deploy file that needs one of
# these raises a pydantic.ValidationError if it's unset):

export TAILSCALE_AUTH_KEY="tskey-auth-xxxxx"                  # deploy_tailscale.py
export COMPUTE_MAC_ADDRESS="aa:bb:cc:dd:ee:ff"                # deploy_gateway_api.py
export GRAFANA_CLOUD_LOKI_URL="https://logs-prod-xxx.grafana.net/loki/api/v1/push"
export GRAFANA_CLOUD_LOKI_USER="123456"
export GRAFANA_CLOUD_LOKI_API_KEY="glc_xxxxx"
export COMPUTE_PROXY_PORT="8081"                               # deploy_caddy.py, ADR-0011

# Have defaults in settings.py, but load-bearing in practice: pyinfra SSHes
# to exactly these hosts to run every Deploy file, including
# deploy_tailscale.py itself -- so on a fresh device that isn't joined yet,
# use a plain LAN address here (e.g. 192.168.0.50), not a tailnet name.
# Safe to leave as the LAN address permanently as long as the
# gateway/compute devices stay on the same local network as the dev
# machine.
export GATEWAY_HOST="pi-zero.tailnet"
export COMPUTE_HOST="main-server.tailnet"

# Each device's real Tailscale MagicDNS name once joined
# (<device>.<tailnet-name>.ts.net -- check `tailscale status` or the admin
# console for your tailnet's actual name). Deliberately separate from
# GATEWAY_HOST/COMPUTE_HOST above: deploy_compute_api.py/deploy_gateway_api.py
# derive UI_ORIGIN/VITE_COMPUTE_API_URL from these two specifically
# (https://{gateway_tailnet_host}, https://{compute_tailnet_host}), since
# that's the only name `tailscale serve` issues a valid HTTPS cert for -- a
# LAN IP origin would fail CORS/HTTPS.
export GATEWAY_TAILNET_HOST="pi-zero.your-tailnet-name.ts.net"
export COMPUTE_TAILNET_HOST="main-server.your-tailnet-name.ts.net"

# Optional -- only export if you need to override the default in settings.py
# export GATEWAY_SSH_USER="pi"
# export COMPUTE_SSH_USER="admin"
# Only needed if compute's `sudo` is aliased to sudo-rs (Ubuntu 26.04
# default): sudo-rs prints "sudo: interactive authentication is required"
# instead of "sudo-rs: ...", which pyinfra's --use-sudo-password doesn't
# recognize, so it fails instead of prompting. Setting this bypasses that
# detection by supplying the password up front via pyinfra's sudo askpass.
# export COMPUTE_SUDO_PASSWORD="hunter2"
