# The Waker service's own secrets/config. Copy to waker-service/.env
# (gitignored, never committed) and fill in real values. Sourced by
# deploy/deploy.sh alongside the repo root .env, which holds the
# homelab-wide device addresses this service's Deploy files read.
#
# Required (no default in deploy/settings.py -- the matching Deploy file
# raises a pydantic.ValidationError if one is unset):

COMPUTE_MAC_ADDRESS="aa:bb:cc:dd:ee:ff"                # deploy_waker.py
GRAFANA_CLOUD_LOKI_URL="https://logs-prod-xxx.grafana.net/loki/api/v1/push"
GRAFANA_CLOUD_LOKI_USER="123456"
GRAFANA_CLOUD_LOKI_API_KEY="glc_xxxxx"

# Optional -- listen ports, only set to override the settings.py defaults
# WAKER_PORT="5000"
# COMPUTE_API_PORT="5000"
