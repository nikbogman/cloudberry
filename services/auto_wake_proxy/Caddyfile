# Auto-wake proxy — Caddyfile
#
# SUPERSEDED as the deployed artifact by ../../pyinfra/templates/Caddyfile.j2
# (../../pyinfra/deploy_caddy.py) -- that templated version is what pyinfra
# actually renders onto the Pi. Kept here as the design reference and
# plugin-research record (see README.md); new workload routes go in
# deploy_caddy.py's WORKLOADS list, not this file.
#
# Runs on the Pi Zero. Reverse-proxies every Docker Compose workload on the
# main server and, on any request while the server is asleep, sends a
# Wake-on-LAN magic packet and holds/retries the request until the server
# answers — transparent to the caller, not an error. Independent of the
# Control Pi API's deliberate /wake endpoint: nothing in this file calls,
# imports, or depends on the Control UI or Control Pi API.
#
# Plugin required (this is NOT a stock Caddy build — see "Build" below):
#
#   github.com/dulli/caddy-wol — registers the `wake_on_lan` HTTP handler
#   directive used below. See README.md's "Plugins" section for the
#   rationale behind this choice.
#
# Build (pyinfra's Caddy deploy owns how this actually gets built/installed
# on the Pi):
#
#   xcaddy build --with github.com/dulli/caddy-wol
#
# Validated via `caddy validate` and a live `caddy run` smoke test — see
# README.md for details.
{
	# Required by caddy-wol: the wake_on_lan handler must run before the
	# built-in `respond`/`error` handlers it's paired with in handle_errors
	# below, or its directive order in the compiled routes would be wrong.
	order wake_on_lan before respond

	# Never bound off-tailnet: exposure to the tailnet happens via an
	# external `tailscale serve` instance in front of Caddy, not this bind.
	# Override via env var only if Caddy binds directly to the Pi's
	# tailnet-interface IP instead of loopback; never set this to a
	# wildcard or off-tailnet address.
	default_bind {$AUTO_WAKE_PROXY_BIND_HOST:127.0.0.1}
}

# --- Reusable auto-wake route -------------------------------------------
#
# One snippet, imported once per workload site block below, so every
# workload gets identical wake/hold/retry behavior without repeating it.
# {args[0]} is the upstream address (host:port) for that workload on the
# main server.
(auto_wake_route) {
	# First attempt: short, cheap check of whether the server is already
	# up. lb_try_duration here is intentionally short — this is just
	# "is it awake right now", not the hold/retry window (that's below).
	reverse_proxy {args[0]} {
		lb_try_duration 3s
		lb_try_interval 500ms
	}

	# reverse_proxy above writes a 502 when it can't reach the upstream at
	# all (connection refused/timeout — the suspended-server case). This is
	# Caddy's own fabricated error for "no reachable backend", and it's the
	# only thing that reaches handle_errors below: a live upstream that
	# itself answers with a genuine 502 gets proxied straight through as an
	# ordinary response, not caught here — no spurious WoL packet.
	handle_errors {
		@server_asleep expression {err.status_code} == 502
		handle @server_asleep {
			# caddy-wol throttles repeat packets to at most one per host
			# per 10 minutes, so concurrent requests during the same wake
			# cycle don't flood the network.
			wake_on_lan {$SERVER_MAC_ADDRESS} {$WOL_BROADCAST_ADDRESS:255.255.255.255:9}

			# Hold/retry the *same* original request against the same
			# upstream with a much longer window, so the caller gets a
			# real response instead of an error while the server wakes.
			# 120s is a bound, not a promise: if resume takes longer, this
			# gives up with a real 502, but the WoL packet already fired
			# (throttled for 10 more minutes), so a reload catches the
			# now-awake server on the fast path above without re-waking it.
			reverse_proxy {args[0]} {
				lb_try_duration 120s
				lb_try_interval 1s
			}
		}
	}
}

# --- Workload routes ------------------------------------------------------
#
# EXAMPLE / PLACEHOLDER ROUTES. No docker-compose.yml files for Immich or
# "AI agents" exist in this repo yet — these are illustrative placeholders,
# to be replaced with real values once those workload stacks exist.
#
# {$MAIN_SERVER_HOST} is a single placeholder for the main server's
# tailnet address/hostname (e.g. a MagicDNS name like
# main-server.<tailnet>.ts.net) — every workload lives on the same
# physical server, so they share this one placeholder and differ only by
# upstream port.
#
# Site addresses here are bare `:port` (plain HTTP on loopback, from
# default_bind above) rather than a hostname — a hostname-shaped site
# address would make Caddy try to provision its own ACME/TLS certificate,
# which is wrong here: tailnet-facing HTTPS is `tailscale serve`'s job (one
# mapping per route below).

# Immich (self-hosted photo/video management). Port 2283 is Immich's
# default web UI port; :8443 (this site's own listening port) is
# illustrative, not verified against a real deployment.
:{$IMMICH_ROUTE_PORT:8443} {
	import auto_wake_route {$MAIN_SERVER_HOST}:2283
}

# "AI agents" workload stack, no docker-compose file in this repo yet —
# both ports are placeholders, to be replaced once that stack is built.
:{$AGENTS_ROUTE_PORT:8444} {
	import auto_wake_route {$MAIN_SERVER_HOST}:8080
}

# Add one site block per additional workload: a single `import
# auto_wake_route <host>:<port>` line plus a `tailscale serve` mapping for
# its listening port.
